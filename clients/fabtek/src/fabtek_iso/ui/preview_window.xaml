<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISO Preview" Height="600" Width="800" Background="#2D2D30">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview Canvas (Dark Mode) -->
        <Border Grid.Row="0" Margin="10" BorderBrush="#444" BorderThickness="1" Background="#1E1E1E">
            <ViewboxStretch="Uniform">
                <Canvas Name="PreviewCanvas" Width="594" Height="420" Background="#000000">
                    <!-- Transformation to flip Y axis because Canvas 0,0 is Top-Left but DXF/ISO is Bottom-Left -->
                    <Canvas.RenderTransform>
                         <ScaleTransform ScaleY="-1" CenterY="210"/>
                    </Canvas.RenderTransform>
                </Canvas>
            </ViewboxStretch>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="Proceed to Sheet Creation?" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Name="BtnOK" Content="Create Sheet" Width="100" Height="30" Margin="5" Click="BtnOK_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Name="BtnCancel" Content="Cancel" Width="80" Height="30" Margin="5" Click="BtnCancel_Click" Background="#444" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
